# Copia este archivo como .env.local y rellena con los datos de tu proyecto Supabase
# (Project Settings → API). Sin estas variables la app funciona en modo local
# con datos de ejemplo guardados en el navegador.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clave publicable (sb_publishable_…) o la anon key antigua.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
